        {
          "name": "Initiate Contract Negotiation (Use Exact Catalog Policy)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.has('FULL_POLICY')) {",
                  "    throw new Error('Full policy not found. Please run \"Query Catalog\" first!');",
                  "}",
                  "",
                  "// Parse the saved policy and inject it into the request",
                  "const fullPolicy = JSON.parse(pm.environment.get('FULL_POLICY'));",
                  "",
                  "// Build the contract request body",
                  "const contractRequest = {",
                  "    '@context': ['https://w3id.org/edc/connector/management/v0.0.1'],",
                  "    '@type': 'ContractRequest',",
                  "    'counterPartyAddress': pm.environment.get('PROVIDER_QNA_DSP_INTERNAL') + '/api/dsp',",
                  "    'counterPartyId': pm.environment.get('PROVIDER_ID'),",
                  "    'protocol': 'dataspace-protocol-http',",
                  "    'policy': fullPolicy",
                  "};",
                  "",
                  "pm.variables.set('contractRequestBody', JSON.stringify(contractRequest));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('CONTRACT_NEGOTIATION_ID', response['@id']);",
                  "    console.log('Contract Negotiation ID: ' + response['@id']);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "value",
                  "value": "{{API_KEY}}",
                  "type": "string"
                },
                {
                  "key": "key",
                  "value": "X-Api-Key",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
