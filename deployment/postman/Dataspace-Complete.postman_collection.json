    {
      "name": "Consumer - Catalog & Negotiation",
      "item": [
        {
          "name": "Query Catalog from Provider QnA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const catalog = pm.response.json();",
                  "    if (catalog['dcat:dataset'] && catalog['dcat:dataset'].length > 0) {",
                  "        const dataset = catalog['dcat:dataset'][0];",
                  "        pm.environment.set('ASSET_ID', dataset['@id']);",
                  "        ",
                  "        if (dataset['odrl:hasPolicy']) {",
                  "            const policy = dataset['odrl:hasPolicy'];",
                  "            pm.environment.set('POLICY_ID', policy['@id']);",
                  "            ",
                  "            // Save complete policy as JSON string for use in negotiation",
                  "            pm.environment.set('FULL_POLICY', JSON.stringify(policy));",
                  "            ",
                  "            console.log('Asset ID: ' + dataset['@id']);",
                  "            console.log('Policy ID: ' + policy['@id']);",
                  "            console.log('Full Policy: ' + JSON.stringify(policy, null, 2));",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "value",
                  "value": "{{API_KEY}}",
                  "type": "string"
                },
                {
                  "key": "key",
                  "value": "X-Api-Key",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"@context\": [\n        \"https://w3id.org/edc/connector/management/v0.0.1\"\n    ],\n    \"@type\": \"CatalogRequest\",\n    \"counterPartyAddress\": \"{{PROVIDER_QNA_DSP_INTERNAL}}/api/dsp\",\n    \"counterPartyId\": \"{{PROVIDER_ID}}\",\n    \"protocol\": \"dataspace-protocol-http\"\n}"
            },
            "url": {
              "raw": "{{CONSUMER_CONNECTOR_MANAGEMENT}}/api/management/v3/catalog/request",
              "host": [
                "{{CONSUMER_CONNECTOR_MANAGEMENT}}"
              ],
              "path": [
                "api",
                "management",
                "v3",
                "catalog",
                "request"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Initiate Contract Negotiation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('CONTRACT_NEGOTIATION_ID', response['@id']);",
                  "    console.log('Contract Negotiation ID: ' + response['@id']);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "value",
                  "value": "{{API_KEY}}",
                  "type": "string"
                },
                {
                  "key": "key",
                  "value": "X-Api-Key",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"@context\": [\n        \"https://w3id.org/edc/connector/management/v0.0.1\"\n    ],\n    \"@type\": \"ContractRequest\",\n    \"counterPartyAddress\": \"{{PROVIDER_QNA_DSP_INTERNAL}}/api/dsp\",\n    \"counterPartyId\": \"{{PROVIDER_ID}}\",\n    \"protocol\": \"dataspace-protocol-http\",\n    \"policy\": {\n        \"@type\": \"Offer\",\n        \"@id\": \"{{POLICY_ID}}\",\n        \"assigner\": \"{{PROVIDER_ID}}\",\n        \"permission\": [\n            {\n                \"action\": \"use\",\n                \"constraint\": {\n                    \"leftOperand\": \"MembershipCredential\",\n                    \"operator\": \"eq\",\n                    \"rightOperand\": \"active\"\n                }\n            }\n        ],\n        \"prohibition\": [],\n        \"obligation\": [],\n        \"target\": \"{{ASSET_ID}}\"\n    }\n}"
            },
            "url": {
              "raw": "{{CONSUMER_CONNECTOR_MANAGEMENT}}/api/management/v3/contractnegotiations",
              "host": [
                "{{CONSUMER_CONNECTOR_MANAGEMENT}}"
              ],
              "path": [
                "api",
                "management",
                "v3",
                "contractnegotiations"
              ]
            }
          },
